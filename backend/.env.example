PORT=4000
MONGODB_URI=
JWT_SECRET=
NODE_ENV=development
GEMINI_API_KEY=

# Production: set to your deployed frontend URL (e.g. https://fundwave.example.com)
FRONTEND_URL=http://localhost:5173

# Production: comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/callback

# SMTP Email Configuration (for Password Reset)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fundwave.com
